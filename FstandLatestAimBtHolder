-- Load script
local function loadScript()
    local ok, err = pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/forrpus3/scripts/refs/heads/main/FstandAb"))()
    end)
    if not ok then
        warn("Script load failed: " .. tostring(err))
    end
end

-- Key check
local VALID_KEY = "assist"

SubmitButton.MouseButton1Click:Connect(function()
    if KeyBox.Text == VALID_KEY then
        StatusLabel.Text = "✅ Key accepted!"
        StatusLabel.TextColor3 = Color3.fromRGB(80, 255, 80)
        task.wait(1)
        -- Fully destroy the key GUI so it doesn't interfere
        MainFrame:Destroy()
        loadScript()
    else
        StatusLabel.Text = "❌ Invalid key. Join Discord to get one."
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
    end
end)

